# Anthropic API Key
# Get yours at: https://console.anthropic.com/
# Copy this file to .env and add your key, OR enter the key in the app's Settings panel at runtime.
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (for Whisper transcription + analysis/chat fallback)
VITE_OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here


# Optional: override Anthropic endpoint.
# In dev, the app defaults to /api/anthropic/v1/messages (Vite proxy).
# In production, set this to your own backend/proxy endpoint if needed.
# VITE_ANTHROPIC_API_BASE_URL=/api/anthropic/v1/messages

# Optional: OpenAI endpoint/model overrides
# VITE_OPENAI_CHAT_API_BASE_URL=/api/openai/v1/chat/completions
# VITE_OPENAI_TRANSCRIPTION_API_BASE_URL=/api/openai/v1/audio/transcriptions
# VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_OPENAI_TRANSCRIPTION_MODEL=whisper-1
